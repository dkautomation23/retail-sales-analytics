{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "line_revenue",
  "position": {
    "x": 16,
    "y": 128,
    "z": 5,
    "height": 280,
    "width": 800,
    "tabOrder": 5
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "month_start"
                }
              },
              "queryRef": "dim_date.month_start",
              "nativeQueryRef": "month_start"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Gross Revenue"
                }
              },
              "queryRef": "fact_sales.Gross Revenue",
              "nativeQueryRef": "Gross Revenue"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
